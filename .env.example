# Copie para .env (que NAO vai pro git). Tudo aqui e opcional: as contas de IA podem ser conectadas pela tela "Conectar IA" do app.

# Senha provisoria do painel (no 1o acesso o app obriga a trocar)
# SENHA=troque-esta-senha

# Qual conta gera o estudo com IA:
#   auto       -> api se ANTHROPIC_API_KEY existir; senao o login do Claude Code (claude); senao o login do `ant`
#   claude-cli -> usa o login do Claude Code de quem instalou (assinatura Claude)
#   api        -> usa ANTHROPIC_API_KEY ou o login do CLI `ant` (ant auth login)
#   demo       -> conteudo de exemplo, sem IA
IA_PROVEDOR=auto
# MODELO_IA=claude-opus-5-5   (sem isso: API usa claude-opus-5-5; login do Claude usa o padrao da instalacao)
# ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Transcricao do audio quando o video nao tem legenda (Groq Whisper)
# GROQ_API_KEY=coloque-sua-chave-aqui
# Varias chaves em revezamento (quando uma bate no limite, a proxima assume):
# GROQ_API_KEYS=chave2,chave3

# Caminhos (so se nao estiverem no PATH)
# YTDLP=/caminho/yt-dlp
# FFMPEG=/caminho/ffmpeg
# CLAUDE_BIN=/caminho/claude
